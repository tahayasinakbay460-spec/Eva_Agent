# Lokal geliştirme için bunu backend/.env olarak kopyala. .env asla commit'lenmez.
# Burada yalnızca anahtar ADLARI durur. Değerler secret manager'dan / kendi ortamından gelir.

EVA_ENV=dev                       # dev | staging | prod
EVA_DATABASE_URL=sqlite+aiosqlite:///./eva_dev.db
# Postgres (docker-compose): postgresql+asyncpg://eva:eva@localhost:5432/eva
EVA_REDIS_URL=redis://localhost:6379/0
EVA_CORS_ORIGINS=["http://localhost:3000"]
EVA_PROVIDERS_CONFIG=../config/providers.yaml
# Tüm özelliklerde LLM adaptörünü zorla değiştirir (mock = internet yok, maliyet yok)
EVA_LLM_PROVIDER_OVERRIDE=

# WebAuthn (passkey). RP ID = passkey'lerin bağlandığı alan adı; canlıda (prod) asla
# değiştirilmez, yoksa kullanıcıların kayıtlı passkey'leri çalışmaz olur.
EVA_WEBAUTHN_RP_ID=localhost
EVA_WEBAUTHN_ORIGINS=["http://localhost:3000"]

# Gözlemlenebilirlik (izleme/metrik; varsayılan kapalı). Verinin gönderileceği OTLP
# adresi standart OTEL_* değişkenleriyle verilir.
EVA_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
EVA_SENTRY_DSN=

OPENAI_API_KEY=                   # LLM (ADR 0004); boşsa EVA_LLM_PROVIDER_OVERRIDE=mock kullan
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
LIVEAVATAR_API_KEY=
LIVEKIT_URL=                      # lokal: ws://localhost:7880 (livekit-server --dev)
LIVEKIT_API_KEY=                  # lokal: devkey
LIVEKIT_API_SECRET=               # lokal: secret
KMS_KEY_ID=
