# Copy to backend/.env for local development. Never commit .env.
# Only key NAMES live here. Values come from your secret manager / local env.

EVA_ENV=dev                       # dev | staging | prod
EVA_DATABASE_URL=sqlite+aiosqlite:///./eva_dev.db
# Postgres (docker-compose): postgresql+asyncpg://eva:eva@localhost:5432/eva
EVA_REDIS_URL=redis://localhost:6379/0
EVA_CORS_ORIGINS=["http://localhost:3000"]
EVA_PROVIDERS_CONFIG=../config/providers.yaml
# Override the LLM adapter for every feature (mock = no network, no cost)
EVA_LLM_PROVIDER_OVERRIDE=

# Observability (off by default). OTLP target uses the standard OTEL_* variables.
EVA_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
EVA_SENTRY_DSN=

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
LIVEAVATAR_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
KMS_KEY_ID=
