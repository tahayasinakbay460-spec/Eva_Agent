# EVA task runner. On Windows without GNU make, run the commands listed under each target
# directly (they are plain uv / npm / docker commands).

.PHONY: dev infra api web test test-py test-ts lint lint-py lint-ts migrate migration gen-client eval

infra:            ## postgres (pgvector), redis, minio
	docker compose -f infra/docker-compose.yml up -d

api:              ## FastAPI with reload on :8000
	cd backend && uv run uvicorn app.main:app --reload --port 8000

web:              ## Next.js dev server on :3000
	cd frontend && npm run dev

dev: infra        ## everything (run api and web in two terminals)
	@echo "run 'make api' and 'make web' in separate terminals"

test: test-py test-ts

test-py:
	cd backend && uv run pytest -q

test-ts:
	cd frontend && npm run typecheck

lint: lint-py lint-ts

lint-py:
	cd backend && uv run ruff format --check . && uv run ruff check . && uv run mypy app tests

lint-ts:
	cd frontend && npm run lint && npm run typecheck

migrate:          ## alembic upgrade head
	cd backend && uv run alembic upgrade head

migration:        ## new autogenerated migration: make migration m="add memories"
	cd backend && uv run alembic revision --autogenerate -m "$(m)"

gen-client:       ## OpenAPI -> frontend/src/lib/api/schema.d.ts
	cd backend && uv run python scripts/export_openapi.py
	cd frontend && npm run gen-client

eval:             ## persona / red-team evals (Phase 1+)
	@echo "evals/ not implemented yet"
