  "components": {
    "schemas": {
      "CodeFlowOut": {
        "properties": {
          "flow_id": {
            "type": "string",
            "format": "uuid",
            "title": "Flow Id"
          },
          "method": {
            "type": "string",
            "const": "email_code",
            "title": "Method",
            "default": "email_code"
          }
        },
        "type": "object",
        "required": [
          "flow_id"
        ],
        "title": "CodeFlowOut",
        "description": "A code was (or, for unknown emails, appears to have been) sent."
      },
      "CodeVerifyRequest": {
        "properties": {
          "flow_id": {
            "type": "string",
            "format": "uuid",
            "title": "Flow Id"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "flow_id",
          "code"
        ],
        "title": "CodeVerifyRequest"
      },
      "ConversationCreate": {
        "properties": {
          "persona_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona Id"
          }
        },
        "type": "object",
        "title": "ConversationCreate"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "persona_id": {
            "type": "string",
            "format": "uuid",
            "title": "Persona Id"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "persona_id",
          "channel",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationOut"
      },
      "DevLoginRequest": {
        "properties": {
          "handle": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[a-z0-9_.-]+$",
            "title": "Handle"
          },
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "handle",
          "display_name"
        ],
        "title": "DevLoginRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "env": {
            "type": "string",
            "title": "Env"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "env",
          "version"
        ],
        "title": "HealthOut"
      },
      "MessageOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "interrupted": {
            "type": "boolean",
            "title": "Interrupted"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "channel",
          "interrupted",
          "created_at"
        ],
        "title": "MessageOut"
      },
      "PasskeyOptionsOut": {
        "properties": {
          "flow_id": {
            "type": "string",
            "format": "uuid",
            "title": "Flow Id"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "flow_id",
          "options"
        ],
        "title": "PasskeyOptionsOut",
        "description": "Options for ``navigator.credentials.create/get`` plus the flow to finish."
      },
      "PasskeySignUpRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          },
          "locale": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ],
            "title": "Locale",
            "default": "tr"
          },
          "age_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Age Confirmed"
          },
          "ai_disclosure_accepted": {
            "type": "boolean",
            "const": true,
            "title": "Ai Disclosure Accepted"
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "age_confirmed",
          "ai_disclosure_accepted"
        ],
        "title": "PasskeySignUpRequest"
      },
      "PasskeyVerifyRequest": {
        "properties": {
          "flow_id": {
            "type": "string",
            "format": "uuid",
            "title": "Flow Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          }
        },
        "type": "object",
        "required": [
          "flow_id",
          "credential"
        ],
        "title": "PasskeyVerifyRequest"
      },
      "PasswordLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "PasswordLoginRequest"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "locale": {
            "type": "string",
